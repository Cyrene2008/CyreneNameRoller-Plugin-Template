{
  "schemaVersion": 1,
  "title": "Template Motion",
  "description": "API 1.1 Web Animations presets for common host targets.",
  "presets": [
    {
      "id": "page-soft-depth",
      "target": "page.transition",
      "label": "柔和景深",
      "description": "带轻微景深与位移的页面进入动画。",
      "default": true,
      "variants": {
        "forward": {
          "keyframes": [
            { "opacity": 0, "transform": "translateX(24px) scale(.985)", "filter": "blur(7px)" },
            { "opacity": 1, "transform": "translateX(0) scale(1)", "filter": "blur(0)" }
          ],
          "options": { "duration": 430, "easing": "cubic-bezier(.2,.8,.2,1)" }
        },
        "backward": {
          "keyframes": [
            { "opacity": 0, "transform": "translateX(-24px) scale(.985)", "filter": "blur(7px)" },
            { "opacity": 1, "transform": "translateX(0) scale(1)", "filter": "blur(0)" }
          ],
          "options": { "duration": 430, "easing": "cubic-bezier(.2,.8,.2,1)" }
        }
      }
    },
    {
      "id": "roller-prismatic-spring",
      "target": "roller.finish",
      "label": "棱镜弹跳",
      "description": "保留轻微放大弹跳，并增加克制的光泽强调。",
      "default": true,
      "animation": {
        "keyframes": [
          { "opacity": 0, "transform": "translateY(14px) scale(.84)", "filter": "blur(8px) saturate(1.35)" },
          { "opacity": 1, "transform": "translateY(-2px) scale(1.055)", "filter": "blur(0) saturate(1.15)", "offset": 0.68 },
          { "opacity": 1, "transform": "translateY(0) scale(1)", "filter": "blur(0) saturate(1)" }
        ],
        "options": { "duration": 680, "easing": "cubic-bezier(.16,1,.3,1)" }
      }
    },
    {
      "id": "card-perspective-arrive",
      "target": "card.deal",
      "label": "透视入场",
      "animation": {
        "keyframes": [
          { "opacity": 0, "transform": "perspective(900px) translateY(42px) rotateX(14deg) scale(.92)" },
          { "opacity": 1, "transform": "perspective(900px) translateY(0) rotateX(0) scale(1)" }
        ],
        "options": { "duration": 560, "easing": "cubic-bezier(.16,1,.3,1)" }
      }
    },
    {
      "id": "card-luminous-flip",
      "target": "card.flip",
      "label": "流光翻牌",
      "animation": {
        "keyframes": [
          { "transform": "perspective(1000px) rotateY(-92deg) scale(.96)", "filter": "brightness(.72) blur(3px)" },
          { "transform": "perspective(1000px) rotateY(5deg) scale(1.025)", "filter": "brightness(1.18) blur(0)", "offset": 0.76 },
          { "transform": "perspective(1000px) rotateY(0) scale(1)", "filter": "brightness(1) blur(0)" }
        ],
        "options": { "duration": 720, "easing": "cubic-bezier(.16,1,.3,1)" }
      }
    },
    {
      "id": "lottery-celebration",
      "target": "lottery.finish",
      "label": "庆典聚焦",
      "animation": {
        "keyframes": [
          { "opacity": 0, "transform": "translateY(18px) scale(.82)", "filter": "blur(10px) brightness(1.4)" },
          { "opacity": 1, "transform": "translateY(-3px) scale(1.07)", "filter": "blur(0) brightness(1.18)", "offset": 0.62 },
          { "opacity": 1, "transform": "translateY(0) scale(1)", "filter": "blur(0) brightness(1)" }
        ],
        "options": { "duration": 760, "easing": "cubic-bezier(.16,1,.3,1)" }
      }
    },
    {
      "id": "global-soft-pulse",
      "target": "global.transition",
      "label": "全局柔光脉冲",
      "animation": {
        "keyframes": [
          { "filter": "saturate(1) brightness(1)" },
          { "filter": "saturate(1.16) brightness(1.035)", "offset": 0.45 },
          { "filter": "saturate(1) brightness(1)" }
        ],
        "options": { "duration": 520, "easing": "cubic-bezier(.2,.8,.2,1)" }
      }
    }
  ]
}
