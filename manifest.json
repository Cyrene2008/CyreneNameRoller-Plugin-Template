{
  "schemaVersion": 1,
  "id": "cn.example.cyrene.plugin",
  "name": "Cyrene Plugin Template",
  "version": "1.4.0",
  "author": "Your Name",
  "description": "A first-party-style CyreneNameRoller Plugin API 1.4 template.",
  "engine": { "min": "1.4.0", "max": "1.4.0" },
  "entry": "src/worker.js",
  "icon": "assets/icon.svg",
  "readme": "README.md",
  "permissions": [
    "storage:read",
    "storage:write",
    "events:draw",
    "events:lifecycle",
    "draw:execute",
    "statistics:read",
    "ui:animations",
    "ui:visual-surfaces",
    "ui:component-styles",
    "ui:component-overrides",
    "ui:native-views",
    "ui:result-presentations",
    "notifications:show",
    "audio:select",
    "audio:play"
  ],
  "contributes": {
    "pages": [
      {
        "id": "settings",
        "title": "Template Plugin",
        "icon": "apps-24-regular",
        "location": "plugins",
        "description": "Native Fluent settings rendered by CyreneNameRoller.",
        "native": {
          "type": "settings",
          "settingsKey": "settings",
          "controls": [
            { "id": "enabled", "type": "toggle", "path": "enabled", "label": "启用插件", "description": "保留配置但暂停插件行为。", "default": true },
            { "id": "volume", "type": "range", "path": "volume", "label": "音量", "description": "范围控件示例。", "min": 0, "max": 1, "step": 0.01, "default": 0.7 },
            { "id": "mode", "type": "select", "path": "mode", "label": "工作模式", "description": "下拉选择控件示例。", "default": "summary", "options": [{ "value": "summary", "label": "每次抽取一次" }, { "value": "each", "label": "每个结果一次" }] },
            { "id": "sound", "type": "audio", "path": "sound", "label": "结果音效", "description": "支持常见本地音频格式。", "accept": "audio/*,.mp3,.m4a,.wav,.flac,.ogg", "default": null },
            { "id": "roller-motion", "type": "animation-select", "target": "roller.finish", "packId": "template-motion", "label": "点名结果动画", "description": "由宿主渲染动画选择器，并安全应用本插件的动画预设。" },
            { "id": "page-motion", "type": "animation-select", "target": "page.transition", "packId": "template-motion", "label": "页面切换动画", "description": "切换插件贡献的页面过渡效果。" },
            { "id": "result-style", "type": "component-style-select", "target": "roller.result", "label": "点名结果样式", "description": "选择本插件为宿主权威结果提供的受限样式包。" },
            { "id": "filter-layout", "type": "component-override-select", "target": "roller.filters", "label": "筛选器布局", "description": "选择隐藏、紧凑或宿主默认的筛选器布局。" },
            { "id": "hide-statistics", "type": "component-override-toggle", "target": "statistics.summary", "packId": "minimal-statistics", "label": "隐藏统计摘要", "description": "用二元开关应用或撤销指定覆盖包。" },
            { "id": "result-layout", "type": "result-presentation-select", "target": "roller.result", "label": "点名结果布局", "description": "选择由宿主绑定 DrawReceipt 的权威结果布局。" }
          ]
        }
      },
      {
        "id": "draw-studio",
        "title": "抽取实验室",
        "titleEn": "Draw Studio",
        "icon": "wand-24-regular",
        "location": "dock",
        "order": 720,
        "description": "使用宿主 CAF 和记录事务构建全新的点名玩法。",
        "entry": "pages/draw-studio.html"
      }
    ],
    "animationPacks": [
      {
        "id": "template-motion",
        "title": "Template Motion",
        "description": "页面、点名、翻牌、抽奖与全局效果示例。",
        "source": "animations/template-motion.json"
      }
    ],
    "visualSurfaces": [
      {
        "id": "ambient-particles",
        "title": "Ambient Particles",
        "entry": "src/visual.js",
        "placement": "background",
        "events": ["app:theme-changed", "app:resize", "draw:result"],
        "defaultEnabled": true
      }
    ],
    "commands": [
      { "id": "refresh", "title": "刷新插件", "titleEn": "Refresh plugin", "locations": ["command-palette", "page-header"], "icon": "arrow-clockwise-24-regular", "order": 300 },
      { "id": "draw-one", "title": "宿主点名一次", "titleEn": "Draw one", "locations": ["command-palette"], "order": 310 },
      { "id": "show-statistics", "title": "读取统计快照", "titleEn": "Show statistics", "locations": ["command-palette"], "order": 320 },
      { "id": "describe-host", "title": "发现宿主能力", "titleEn": "Describe host", "locations": ["command-palette"], "order": 330 }
    ],
    "componentStylePacks": [
      {
        "id": "focused",
        "title": "专注模式",
        "targets": {
          "roller.primary-action": {
            "size": "large",
            "foreground": "#ffffff",
            "background": "#005a9e",
            "fontFamily": "host:ui",
            "fontSize": 18,
            "fontWeight": 700,
            "radius": 8
          },
          "roller.result": {
            "size": "large",
            "foreground": "#172033",
            "background": "#ffffff",
            "fontFamily": "host:display",
            "fontSize": 72,
            "fontWeight": 700,
            "alignment": "center",
            "padding": "comfortable",
            "gap": "comfortable"
          },
          "lottery.result": {
            "size": "large",
            "foreground": "#172033",
            "background": "#ffffff",
            "fontFamily": "host:display",
            "fontSize": 48,
            "fontWeight": 700,
            "alignment": "center"
          }
        }
      },
      {
        "id": "compact-navigation",
        "title": "紧凑导航",
        "targets": {
          "navigation.dock": {
            "size": "small",
            "foreground": "#ffffff",
            "background": "#243447",
            "fontFamily": "host:ui",
            "fontSize": 14,
            "fontWeight": 600,
            "density": "compact"
          },
          "roller.current-list": {
            "size": "medium",
            "foreground": "#172033",
            "background": "#ffffff",
            "fontFamily": "host:ui",
            "fontSize": 14,
            "fontWeight": 600,
            "padding": "compact",
            "gap": "compact"
          },
          "roller.filters": {
            "size": "small",
            "foreground": "#172033",
            "background": "#f3f6f9",
            "fontFamily": "host:ui",
            "fontSize": 13,
            "fontWeight": 500,
            "padding": "compact",
            "gap": "compact"
          },
          "app.version-badge": {
            "foreground": "#ffffff",
            "background": "#536878",
            "fontFamily": "host:numeric",
            "fontSize": 11,
            "fontWeight": 600,
            "padding": "compact"
          }
        }
      },
      {
        "id": "cards-and-statistics",
        "title": "卡牌与统计",
        "targets": {
          "card.controls": {
            "size": "small",
            "foreground": "#172033",
            "background": "#f3f6f9",
            "fontFamily": "host:ui",
            "fontSize": 14,
            "fontWeight": 600,
            "padding": "compact",
            "gap": "compact"
          },
          "card.deck": {
            "size": "medium",
            "foreground": "#172033",
            "background": "#ffffff",
            "padding": "comfortable",
            "gap": "normal"
          },
          "card.item": {
            "size": "medium",
            "foreground": "#172033",
            "background": "#ffffff",
            "fontFamily": "host:display",
            "fontSize": 20,
            "fontWeight": 700,
            "radius": 10,
            "shadow": "medium"
          },
          "statistics.summary": {
            "size": "small",
            "foreground": "#172033",
            "background": "#eef5f7",
            "fontFamily": "host:numeric",
            "fontSize": 14,
            "fontWeight": 600,
            "padding": "normal",
            "gap": "compact"
          }
        }
      }
    ],
    "componentOverridePacks": [
      {
        "id": "focus-mode",
        "title": "精简点名界面",
        "targets": {
          "app.version-badge": { "visibility": "hidden", "layout": "collapse" },
          "roller.filters": { "visibility": "hidden", "layout": "collapse" }
        }
      },
      {
        "id": "compact-filters",
        "title": "紧凑筛选器",
        "targets": {
          "roller.filters": { "visibility": "visible", "layout": "compact" }
        }
      },
      {
        "id": "minimal-statistics",
        "title": "最小统计界面",
        "targets": {
          "statistics.summary": { "visibility": "hidden", "layout": "reserve" }
        }
      }
    ],
    "nativeViews": [
      {
        "id": "roller-stats",
        "title": "点名统计",
        "titleEn": "Roller statistics",
        "slot": "slot:roller.side-panel",
        "source": "views/roller-stats.json",
        "uses": ["statistics:read", "draw:execute"],
        "order": 200
      },
      {
        "id": "below-result",
        "title": "结果上下文",
        "titleEn": "Result context",
        "slot": "slot:roller.below-result",
        "source": "views/below-result.json",
        "uses": [],
        "order": 210
      },
      {
        "id": "records-toolbar",
        "title": "记录工具栏",
        "titleEn": "Records toolbar",
        "slot": "slot:records.toolbar",
        "source": "views/records-toolbar.json",
        "uses": ["statistics:read"],
        "order": 100
      }
    ],
    "resultPresentations": [
      {
        "id": "single-compact",
        "title": "单人紧凑",
        "titleEn": "Single compact",
        "targets": ["roller.result"],
        "layout": "single",
        "style": {
          "size": "small",
          "alignment": "start",
          "showAlgorithm": false,
          "showOperationId": false,
          "showEnglishName": true
        }
      },
      {
        "id": "list-readable",
        "title": "易读列表",
        "titleEn": "Readable list",
        "targets": ["roller.result"],
        "layout": "list",
        "style": {
          "size": "medium",
          "alignment": "start",
          "showAlgorithm": true,
          "showOperationId": false,
          "showEnglishName": true
        }
      },
      {
        "id": "grid-summary",
        "title": "网格摘要",
        "titleEn": "Grid summary",
        "targets": ["roller.result"],
        "layout": "grid",
        "style": {
          "size": "medium",
          "alignment": "center",
          "showAlgorithm": false,
          "showOperationId": true,
          "showEnglishName": false
        }
      },
      {
        "id": "spotlight",
        "title": "聚光结果",
        "titleEn": "Spotlight",
        "targets": ["roller.result"],
        "layout": "spotlight",
        "style": {
          "size": "large",
          "alignment": "center",
          "showAlgorithm": true,
          "showOperationId": true,
          "showEnglishName": true
        }
      }
    ]
  }
}

