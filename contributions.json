{
  "settings": {
    "title": "Draw Studio",
    "description": "宿主原生 Fluent 设置页；与 iframe 页面共用同一 storageKey。",
    "storageKey": "settings",
    "sections": [
      {
        "id": "general",
        "title": "常规",
        "fields": [
          {
            "id": "enabled",
            "type": "toggle",
            "path": "enabled",
            "label": "启用模板示例功能",
            "description": "关闭后 worker 仍可响应命令，但不主动参与结果事件。",
            "default": true
          },
          {
            "id": "volume",
            "type": "slider",
            "path": "volume",
            "label": "提示音量",
            "description": "预览与通知音效共用的音量。",
            "min": 0,
            "max": 1,
            "step": 0.01,
            "default": 0.7
          },
          {
            "id": "mode",
            "type": "select",
            "path": "mode",
            "label": "结果摘要",
            "description": "决定 worker 读取资源后返回的摘要粒度。",
            "default": "summary",
            "options": [
              {
                "value": "summary",
                "label": "仅摘要"
              },
              {
                "value": "full",
                "label": "完整快照"
              }
            ]
          },
          {
            "id": "sound",
            "type": "audio",
            "path": "sound",
            "label": "自定义提示音",
            "description": "由宿主选择本地音频文件。",
            "accept": "audio/*,.mp3,.m4a,.wav,.flac,.ogg",
            "default": null
          }
        ]
      },
      {
        "id": "appearance",
        "title": "界面与呈现",
        "fields": [
          {
            "id": "result-style",
            "type": "component-style-select",
            "target": "roller.result",
            "label": "点名结果样式"
          },
          {
            "id": "filter-layout",
            "type": "component-override-select",
            "target": "roller.filters",
            "label": "筛选区布局"
          },
          {
            "id": "hide-statistics",
            "type": "component-override-toggle",
            "target": "statistics.summary",
            "packId": "minimal-statistics",
            "label": "隐藏统计摘要卡片"
          },
          {
            "id": "result-layout",
            "type": "result-presentation-select",
            "target": "roller.result",
            "label": "权威结果呈现"
          },
          {
            "id": "page-animation",
            "type": "animation-select",
            "target": "page.transition",
            "packId": "template-motion",
            "label": "页面切换动画"
          },
          {
            "id": "result-animation",
            "type": "animation-select",
            "target": "roller.finish",
            "packId": "template-motion",
            "label": "点名结果动画"
          }
        ]
      }
    ]
  },
  "pages": [
    {
      "id": "draw-studio",
      "title": "Draw Studio",
      "titleEn": "Draw Studio",
      "icon": "sparkle-24-regular",
      "location": "dock",
      "order": 640,
      "entry": "pages/draw-studio.html",
      "description": "iframe 富页面示例：通过 window.CyrenePlugin.request 提交宿主权威抽取事务。"
    }
  ],
  "commands": [
    {
      "id": "refresh",
      "title": "读取插件设置",
      "titleEn": "Read plugin settings",
      "locations": [
        "command-palette",
        "page-header"
      ],
      "icon": "arrow-clockwise-24-regular",
      "order": 300
    },
    {
      "id": "draw-one",
      "title": "宿主抽取一个结果",
      "titleEn": "Draw one result",
      "locations": [
        "command-palette"
      ],
      "icon": "sparkle-24-regular",
      "order": 310
    },
    {
      "id": "show-statistics",
      "title": "显示统计快照",
      "titleEn": "Show statistics",
      "locations": [
        "command-palette"
      ],
      "icon": "data-trending-24-regular",
      "order": 320
    },
    {
      "id": "describe-host",
      "title": "发现宿主能力",
      "titleEn": "Describe host",
      "locations": [
        "command-palette"
      ],
      "icon": "info-24-regular",
      "order": 330
    }
  ],
  "animationPacks": [
    {
      "id": "template-motion",
      "title": "Template Motion",
      "description": "模板随附的受限动画预设。",
      "source": "animations/template-motion.json"
    }
  ],
  "visualSurfaces": [
    {
      "id": "ambient-canvas",
      "title": "环境视觉画布",
      "entry": "src/visual.js",
      "placement": "background",
      "defaultEnabled": true,
      "events": [
        "app:ready",
        "app:route-changed",
        "app:theme-changed",
        "app:resize",
        "plugin:storage-changed",
        "roller:result",
        "card:result",
        "lottery:result"
      ]
    }
  ],
  "componentStylePacks": [
    {
      "id": "focused",
      "title": "Focused",
      "targets": {
        "roller.primary-action": {
          "size": "large",
          "foreground": "#ffffff",
          "background": "#005a9e",
          "fontFamily": "host:ui",
          "fontSize": 18,
          "fontWeight": 700,
          "radius": 8
        },
        "roller.result": {
          "size": "large",
          "foreground": "#172033",
          "background": "#ffffff",
          "fontFamily": "host:display",
          "fontSize": 72,
          "fontWeight": 700,
          "alignment": "center",
          "padding": "comfortable",
          "gap": "comfortable"
        },
        "lottery.result": {
          "size": "large",
          "foreground": "#172033",
          "background": "#ffffff",
          "fontFamily": "host:display",
          "fontSize": 48,
          "fontWeight": 700,
          "alignment": "center"
        }
      }
    },
    {
      "id": "compact-navigation",
      "title": "Compact navigation",
      "targets": {
        "navigation.dock": {
          "size": "small",
          "foreground": "#ffffff",
          "background": "#243447",
          "fontFamily": "host:ui",
          "fontSize": 14,
          "fontWeight": 600,
          "density": "compact"
        },
        "roller.current-list": {
          "size": "medium",
          "foreground": "#172033",
          "background": "#ffffff",
          "fontFamily": "host:ui",
          "fontSize": 14,
          "fontWeight": 600,
          "padding": "compact",
          "gap": "compact"
        },
        "roller.filters": {
          "size": "small",
          "foreground": "#172033",
          "background": "#f3f6f9",
          "fontFamily": "host:ui",
          "fontSize": 13,
          "fontWeight": 500,
          "padding": "compact",
          "gap": "compact"
        },
        "app.version-badge": {
          "foreground": "#ffffff",
          "background": "#536878",
          "fontFamily": "host:numeric",
          "fontSize": 11,
          "fontWeight": 600,
          "padding": "compact"
        }
      }
    },
    {
      "id": "cards-and-statistics",
      "title": "Cards and statistics",
      "targets": {
        "card.controls": {
          "size": "small",
          "foreground": "#172033",
          "background": "#f3f6f9",
          "fontFamily": "host:ui",
          "fontSize": 14,
          "fontWeight": 600,
          "padding": "compact",
          "gap": "compact"
        },
        "card.deck": {
          "size": "medium",
          "foreground": "#172033",
          "background": "#ffffff",
          "padding": "comfortable",
          "gap": "normal"
        },
        "card.item": {
          "size": "medium",
          "foreground": "#172033",
          "background": "#ffffff",
          "fontFamily": "host:display",
          "fontSize": 20,
          "fontWeight": 700,
          "radius": 10,
          "shadow": "medium"
        },
        "statistics.summary": {
          "size": "small",
          "foreground": "#172033",
          "background": "#eef5f7",
          "fontFamily": "host:numeric",
          "fontSize": 14,
          "fontWeight": 600,
          "padding": "normal",
          "gap": "compact"
        }
      }
    }
  ],
  "componentOverridePacks": [
    {
      "id": "focus-mode",
      "title": "Focus mode",
      "targets": {
        "app.version-badge": {
          "visibility": "hidden",
          "layout": "collapse"
        },
        "roller.filters": {
          "visibility": "hidden",
          "layout": "collapse"
        }
      }
    },
    {
      "id": "compact-filters",
      "title": "Compact filters",
      "targets": {
        "roller.filters": {
          "visibility": "visible",
          "layout": "compact"
        }
      }
    },
    {
      "id": "minimal-statistics",
      "title": "Minimal statistics",
      "targets": {
        "statistics.summary": {
          "visibility": "hidden",
          "layout": "reserve"
        }
      }
    }
  ],
  "nativeViews": [
    {
      "id": "roller-stats",
      "title": "Roller statistics",
      "slot": "slot:roller.side-panel",
      "source": "views/roller-stats.json",
      "uses": [
        "statistics:read",
        "draw:execute"
      ],
      "order": 200
    },
    {
      "id": "below-result",
      "title": "Result context",
      "slot": "slot:roller.below-result",
      "source": "views/below-result.json",
      "uses": [],
      "order": 210
    },
    {
      "id": "records-toolbar",
      "title": "Records toolbar",
      "slot": "slot:records.toolbar",
      "source": "views/records-toolbar.json",
      "uses": [
        "statistics:read"
      ],
      "order": 100
    }
  ],
  "resultPresentations": [
    {
      "id": "single-compact",
      "title": "Single compact",
      "targets": [
        "roller.result"
      ],
      "layout": "single",
      "style": {
        "size": "small",
        "alignment": "start",
        "showAlgorithm": false,
        "showOperationId": false,
        "showEnglishName": true
      }
    },
    {
      "id": "list-readable",
      "title": "Readable list",
      "targets": [
        "roller.result"
      ],
      "layout": "list",
      "style": {
        "size": "medium",
        "alignment": "start",
        "showAlgorithm": true,
        "showOperationId": false,
        "showEnglishName": true
      }
    },
    {
      "id": "grid-summary",
      "title": "Grid summary",
      "targets": [
        "roller.result"
      ],
      "layout": "grid",
      "style": {
        "size": "medium",
        "alignment": "center",
        "showAlgorithm": false,
        "showOperationId": true,
        "showEnglishName": false
      }
    },
    {
      "id": "spotlight",
      "title": "Spotlight",
      "targets": [
        "roller.result"
      ],
      "layout": "spotlight",
      "style": {
        "size": "large",
        "alignment": "center",
        "showAlgorithm": true,
        "showOperationId": true,
        "showEnglishName": true
      }
    }
  ]
}
